  },
  "templates": [
    {
      "id": "tpl.001",
      "fr": "Votre solde est {amount}",
      "ewo": "",
      "regex": "^Votre solde est (?<amount>.+?)\\.?$",
      "critical": true,
      "status": "a_valider"
    },
    {
      "id": "tpl.002",
      "fr": "Les frais sont de {amount}",
      "ewo": "",
      "regex": "^Les frais sont de (?<amount>.+?)\\.?$",
      "critical": true,
      "status": "a_valider"
    },
    {
      "id": "tpl.003",
      "fr": "Frais de transfert : {amount}",
      "ewo": "",
      "regex": "^Frais de transfert\\s*:\\s*(?<amount>.+?)\\.?$",
      "critical": true,
      "status": "a_valider"
    },
    {
      "id": "tpl.004",
      "fr": "Total à payer : {amount}",
      "ewo": "",
      "regex": "^Total à payer\\s*:\\s*(?<amount>.+?)\\.?$",
      "critical": true,
      "status": "a_valider"
    },
    {
      "id": "tpl.005",
      "fr": "Vous allez envoyer {amount} à {beneficiary}",
      "ewo": "",
      "regex": "^Vous allez envoyer (?<amount>.+?) à (?<beneficiary>.+?)\\.?$",
      "critical": true,
      "status": "a_valider"
    },
    {
      "id": "tpl.006",
      "fr": "Transfert de {amount} vers {beneficiary} réussi",
      "ewo": "",
      "regex": "^Transfert de (?<amount>.+?) vers (?<beneficiary>.+?) réussi\\.?$",
      "critical": true,
      "status": "a_valider"
    },
    {
      "id": "tpl.007",
      "fr": "Vous avez reçu {amount} de {sender}",
      "ewo": "",
      "regex": "^Vous avez reçu (?<amount>.+?) de (?<sender>.+?)\\.?$",
      "critical": true,
      "status": "a_valider"
    },
    {
      "id": "tpl.008",
      "fr": "Veuillez confirmer le transfert de {amount}",
      "ewo": "",
