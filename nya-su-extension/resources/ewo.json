      "critical": true,
      "status": "a_valider"
    },
    {
      "id": "tpl.009",
      "fr": "Solde insuffisant. Votre solde est {amount}",
      "ewo": "",
      "regex": "^Solde insuffisant\\. Votre solde est (?<amount>.+?)\\.?$",
      "critical": true,
      "status": "a_valider"
    },
    {
      "id": "tpl.010",
      "fr": "Montant minimum : {amount}",
      "ewo": "",
      "regex": "^Montant minimum\\s*:\\s*(?<amount>.+?)\\.?$",
      "critical": true,
      "status": "a_valider"
    },
    {
      "id": "tpl.011",
      "fr": "Montant maximum : {amount}",
      "ewo": "",
      "regex": "^Montant maximum\\s*:\\s*(?<amount>.+?)\\.?$",
      "critical": true,
      "status": "a_valider"
    },
    {
      "id": "tpl.012",
      "fr": "Entrez le code envoyé au {phone}",
      "ewo": "",
      "regex": "^Entrez le code envoyé au (?<phone>.+?)\\.?$",
      "critical": true,
      "status": "a_valider"
    },
    {
      "id": "tpl.013",
