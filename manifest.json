{
  "manifest_version": 3,
  "name": "nya-su — Traducteur Ewondo",
  "short_name": "nya-su",
  "version": "1.0.3",
  "description": "Traduit les pages et interfaces en Ewondo (dictionnaire validé + API de secours). Mode hors-ligne optionnel.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "nya-su",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": ["contextMenus", "storage", "activeTab"],
  "host_permissions": ["https://*.up.railway.app/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-page": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Traduire la page en Ewondo / voir l'original"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": []
}
